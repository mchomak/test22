NEXT_PUBLIC_SITE_URL=https://example.com
DEPLOYMENT_VERSION=local
APP_PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# HTTP or SOCKS5 proxy for Telegram Bot API (useful if api.telegram.org is blocked).
# Format: socks5://host:port or http://host:port
# Note: MTProto proxies (used in Telegram app) are NOT compatible — use SOCKS5/HTTP only.
TELEGRAM_PROXY_URL=
TELEGRAM_REQUEST_TIMEOUT_MS=15000

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgres://portfolio:change-this-password@localhost:5432/portfolio
DATABASE_POOL_MAX=5
DATABASE_SSL=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
ANALYTICS_SALT=generate-another-long-random-secret
